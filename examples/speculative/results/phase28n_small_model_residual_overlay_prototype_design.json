  "budget_calculator_design": {
    "file": "examples/speculative/prt_residual_budget.py",
    "inputs": [
      "model_param_count", "base_bits", "residual_bits",
      "residual_layer_count", "residual_fraction", "context_size",
      "kv_estimate_per_token", "runtime_buffer_estimate",
      "os_headroom", "ram_budget"
    ],
    "outputs": [
      "estimated_base_bytes", "estimated_residual_bytes",
      "estimated_kv_bytes", "estimated_total_resident",
      "safe_unsafe", "residual_budget_remaining", "residual_too_large"
    ],
    "formula": "base_bytes = param*bits/8; residual = param*fraction*residual_bits/8; total = base + kv + residual + buffers + headroom",
    "no_model_files_needed": true
  },
  "offline_script_design": {
    "file": "examples/speculative/prt_residual_overlay_offline.py",
    "inputs": {
      "--mode": "synthetic | slice",
      "--rows": 512,
      "--cols": 2048,
      "--base-bits": 2,
      "--residual-format": "ternary | int2 | int4",
      "--budget-mb": 2048,
      "--out-json": "PATH (required)"
    },
    "pipeline": [
      "Generate/load W_ref",
      "Quantize to Q2: W_base = round(W_ref / q2_step) * q2_step",
      "Compute R = W_ref - W_base",
      "Compress R to ternary/int2/int4",
      "Reconstruct W_hat = W_base + R_hat",
      "Generate synthetic x (fixed seed)",
      "Compare y_ref, y_base, y_hat matvecs",
      "Report cosine, MAE, L2, storage metrics"
    ],
    "metrics": [
      "cosine_improvement",
      "mae_improvement_pct",
      "relative_l2_improvement",
      "compression_ratio",
      "pass/fail under budget"
    ]
  },
  "acceptance_criteria": {
