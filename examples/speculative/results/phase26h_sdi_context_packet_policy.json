  "sdi_context_policy": {
    "name": "sdi_context_policy_v0_1",
    "type": "prompt assembly policy",
    "repo_agnostic": true,
    "inputs": [
      "user_message",
      "recent_turns",
      "pinned_facts",
      "retrieved_memories",
      "task_type",
      "target_model",
      "context_budget",
