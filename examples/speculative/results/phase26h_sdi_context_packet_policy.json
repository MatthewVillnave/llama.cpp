      "estimated_tokens",
      "included_facts",
      "dropped_content",
      "compression_reason",
      "safety_warnings",
      "tier",
      "model_used"
    ],
    "tiers": {
      "0_emergency": {
        "when": "swap > 1GB OR memory tight",
        "target_tokens": "≤1024",
        "includes": "current message + pinned facts + last 1-2 turns"
      },
      "1_safe_default": {
        "when": "memory OK, normal task",
        "target_tokens": "≤2048-4096",
        "includes": "current message + pinned facts + recent window + memories"
      },
      "2_extended_safe": {
        "when": "memory OK, complex task (planning/creative)",
        "target_tokens": "≤4096-8192",
        "includes": "current message + pinned facts + ContextOS packet + recent window + tool outputs"
      },
      "3_full_context": {
        "when": "memory headroom confirmed, no swap pressure",
        "target_tokens": "≤8192-16384",
        "includes": "everything — only with explicit approval"
      }
    },
    "key_principles": [
      "pinned facts are sacred — never modified or dropped",
      "never invent facts — mark uncertain as [uncertain]",
      "drop filler, not structure — preserve IDs, numbers, paths, constraints",
      "ContextOS packet is the compression unit",
      "deterministic — same inputs produce same outputs"
    ]
  },
  "packet_format": {
    "format": "markdown [SDI_CONTEXT_PACKET] block",
    "fields": [
      "Goal",
      "Current user request",
      "Pinned facts",
      "Hard constraints",
      "Relevant memory",
      "Open loops",
      "Recent state",
      "Tool/output facts",
      "Dropped context summary",
      "Uncertainty",
      "Memory/safety note"
    ],
    "rules": [
      "preserve exact IDs, names, numbers, paths, commits, tags, constraints",
      "never invent facts",
      "mark uncertain facts explicitly as [uncertain]",
      "keep user constraints verbatim when important",
      "do not include filler or raw logs",
      "pinned facts before summaries",
      "dropped context always explained"
    ]
  },
  "memory_swap_guard": {
    "purpose": "pre-inference safety check",
    "rules": [
      {"condition": "swap_used > 1GB", "action": "BLOCK local 7B inference"},
      {"condition": "total_estimate > 85% MemAvailable", "action": "BLOCK or route to smaller model"},
